{
  "expo": {
    "name": "Flo Staging",
    "slug": "flo-mobile-staging",
    "owner": "testamplify-org",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "flostaging",
    "ios": {
      "bundleIdentifier": "com.testamplify.flo.staging",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.testamplify.flo.staging",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Flo to use the camera when you turn video on.",
          "microphonePermission": "Allow Flo to use the microphone when you unmute."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f3270dc2-7495-4ad5-8746-486609b2b52a"
      }
    },
    "icon": "./assets/flo-icon.png"
  }
}
